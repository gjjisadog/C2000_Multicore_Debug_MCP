{
  "name": "c2000-multicore-mcp",
  "version": "0.1.0",
  "description": "Explicit multicore MCP debug server for TI C2000 CCS Debug Server workflows.",
  "type": "module",
  "bin": {
    "c2000-multicore-mcp": "./dist/src/index.js",
    "c2000-debugd": "./dist/src/daemon/index.js",
    "c2000-board-worker": "./dist/src/worker/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs -p tsconfig.src.json",
    "build:all": "node scripts/build.mjs -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "daemon:dev": "tsx src/daemon/index.ts",
    "daemon:start": "node dist/src/daemon/index.js",
    "daemon:detached": "node dist/src/daemon/index.js --detached",
    "proxy:dev": "tsx src/index.ts",
    "proxy:start": "node dist/src/index.js",
    "worker:dev": "tsx src/worker/index.ts",
    "start:supervised": "node scripts/mcp-supervisor.mjs -- node dist/src/index.js",
    "test": "vitest run",
    "postinstall": "node -e \"try{require('fs').accessSync('node_modules/typescript/lib/_tsc.js')}catch{console.warn('[c2000-multicore-mcp] typescript CLI missing; run npm install typescript --save-dev')}\"",
    "verify:debug-boundary": "tsx scripts/verify-debug-boundary.ts",
    "verify:host": "tsx scripts/verify-host-gate.ts",
    "verify:daemon-proxy": "vitest run tests/daemonProxyLifecycle.test.ts tests/jobPersistence.test.ts",
    "verify:daemon-restart": "vitest run tests/daemonProcessRecoveryE2E.test.ts",
    "verify:can:mock": "vitest run tests/boardGroupBarrier.test.ts tests/canAcceptanceService.test.ts tests/canProfileEvidence.test.ts tests/canCampaignJob.test.ts tests/canGroupReconciler.test.ts tests/canJobPersistence.test.ts",
    "acceptance:can:mock": "npm run verify:can:mock",
    "acceptance:can:fault-campaign": "vitest run tests/canCampaignJob.test.ts",
    "acceptance:can:soak": "vitest run tests/canCampaignJob.test.ts",
    "acceptance:can:hardware": "tsx scripts/verify-two-board-can-hardware.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:mcp": "npm run build --silent && tsx scripts/mcp-stdio-smoke.ts",
    "doctor": "node scripts/c2000-mcp-doctor.mjs",
    "doctor:isolated": "node scripts/c2000-mcp-doctor.mjs --isolated",
    "verify:runtime-cwd": "npm run build --silent && node scripts/c2000-mcp-doctor.mjs --isolated --verify-worker",
    "benchmark:debug": "tsx scripts/debug-performance-benchmark.ts",
    "benchmark:hardware": "tsx scripts/debug-hardware-benchmark.ts",
    "acceptance:preflight": "tsx scripts/ccs-preflight.ts",
    "acceptance:ready": "npm run build --silent && tsx scripts/ccs-acceptance-readiness.ts",
    "acceptance:ccs": "tsx scripts/ccs-hardware-acceptance.ts",
    "acceptance:ccs:mcp": "npm run build --silent && tsx scripts/ccs-mcp-hardware-acceptance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.3",
    "typescript": "5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "packageManager": "npm@10"
}
