{
  "adapter": "ccs",
  "ccs": {
    "ccxmlPath": "<absolute path to your serial-bound DK8 .ccxml>",
    "scriptingMode": "ccs"
  },
  "target": {
    "name": "F28P650DK8",
    "coreMap": [
      {
        "coreId": 0,
        "coreName": "C28xx_CPU1",
        "corePattern": "C28xx_CPU1"
      },
      {
        "coreId": 2,
        "coreName": "C28xx_CPU2",
        "corePattern": "C28xx_CPU2"
      }
    ]
  },
  "debugProbe": {
    "probes": [
      {
        "probeId": "dk8-x200",
        "serialNumber": "REPLACE_WITH_XDS2XX_SERIAL",
        "ccxmlPath": "<absolute path to your serial-bound DK8 .ccxml>",
        "enabled": true
      }
    ]
  },
  "diagnostics": {
    "cpu1BootExpressions": [
      "g_emHybrid30kCpu1Stage",
      "g_ulHybrid30kIpcPass",
      "g_ulHybrid30kMsgRamPass",
      "g_ulHybrid30kParamPass"
    ],
    "cpu2BootExpressions": [
      "g_emHybrid30kCpu2Stage"
    ]
  },
  "logging": {
    "level": "info"
  }
}
